{
  "description": "WebAssembly bindings for brepkit — browser-native B-Rep solid modeling",
  "exports": {
    ".": {
      "node": "./brepkit_wasm_node.cjs",
      "import": "./brepkit_wasm.js",
      "default": "./brepkit_wasm.js"
    },
    "./brepkit_wasm_bg.wasm": "./brepkit_wasm_bg.wasm"
  },
  "files": [
    "brepkit_wasm_bg.wasm",
    "brepkit_wasm.js",
    "brepkit_wasm_bg.js",
    "brepkit_wasm.d.ts",
    "LICENSE-APACHE",
    "brepkit_wasm_node.cjs"
  ],
  "keywords": [
    "cad",
    "brep",
    "wasm",
    "geometry",
    "solid-modeling"
  ],
  "license": "Apache-2.0",
  "main": "brepkit_wasm_node.cjs",
  "module": "brepkit_wasm.js",
  "name": "brepkit-wasm",
  "repository": {
    "type": "git",
    "url": "https://github.com/esaueng/brepkit"
  },
  "sideEffects": [
    "./brepkit_wasm.js",
    "./snippets/*"
  ],
  "type": "module",
  "types": "brepkit_wasm.d.ts",
  "version": "2.130.0"
}
