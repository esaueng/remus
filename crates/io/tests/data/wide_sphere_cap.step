ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('remus STEP export'), '2;1');
FILE_NAME('output.stp', '2024-01-01T00:00:00', (''), (''), 'remus', 'remus', '');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
