#9 = PRODUCT('remus_solid', 'remus_solid', '', (#7));
#10 = PRODUCT_DEFINITION_FORMATION('', '', #9);
#11 = PRODUCT_DEFINITION_CONTEXT('part definition', #6, 'design');
#12 = PRODUCT_DEFINITION('design', '', #10, #11);
#13 = CARTESIAN_POINT('', (0., 0., 7.50000000000000000E0));
#14 = DIRECTION('', (0., 0., 1.00000000000000000E0));
#15 = DIRECTION('', (0., 1.00000000000000000E0, 0.));
#16 = AXIS2_PLACEMENT_3D('', #13, #14, #15);
#17 = PLANE('', #16);
#18 = CARTESIAN_POINT('', (0., 0., 0.));
#19 = DIRECTION('', (0., 0., 1.00000000000000000E0));
#20 = DIRECTION('', (1.00000000000000000E0, 0., 0.));
#21 = AXIS2_PLACEMENT_3D('', #18, #19, #20);
#22 = SPHERICAL_SURFACE('', #21, 9.00000000000000000E0);
#23 = CARTESIAN_POINT('', (0., 4.97493718553309971E0, 7.50000000000000000E0));
#24 = VERTEX_POINT('', #23);
#25 = CARTESIAN_POINT('', (0., 0., 7.50000000000000000E0));
#26 = DIRECTION('', (0., 0., 1.00000000000000000E0));
#27 = DIRECTION('', (0., 1.00000000000000000E0, 0.));
#28 = AXIS2_PLACEMENT_3D('', #25, #26, #27);
#29 = CIRCLE('', #28, 4.97493718553309971E0);
#30 = TRIMMED_CURVE('', #29, (PARAMETER_VALUE(0.00000000000000000E0)), (PARAMETER_VALUE(6.28318530717958623E0)), .T., .PARAMETER.);
#31 = EDGE_CURVE('', #24, #24, #30, .T.);
#32 = ORIENTED_EDGE('', *, *, #31, .T.);
#33 = EDGE_LOOP('', (#32));
#34 = FACE_OUTER_BOUND('', #33, .T.);
#35 = ADVANCED_FACE('', (#34), #17, .T.);
#36 = ORIENTED_EDGE('', *, *, #31, .F.);
#37 = EDGE_LOOP('', (#36));
#38 = FACE_OUTER_BOUND('', #37, .T.);
#39 = ADVANCED_FACE('', (#38), #22, .T.);
#40 = CLOSED_SHELL('', (#35, #39));
#41 = MANIFOLD_SOLID_BREP('', #40);
