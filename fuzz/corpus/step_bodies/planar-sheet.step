#27 = ORIENTED_EDGE('', *, *, #26, .T.);
#28 = CARTESIAN_POINT('', (1.00000000000000000E0, 5.00000000000000000E-1, 0.));
#29 = VERTEX_POINT('', #28);
#30 = CARTESIAN_POINT('', (1.00000000000000000E0, -5.00000000000000000E-1, 0.));
