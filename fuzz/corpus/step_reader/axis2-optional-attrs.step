ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('omitted OPTIONAL placement attributes'),'2;1');
FILE_NAME('axis2-optional-attrs.step','2026-01-01T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN'));
ENDSEC;
DATA;
/* A radius-4, height-10 cylinder that reaches build_axis2_placement from a
   MANIFOLD_SOLID_BREP: without a solid the reader never resolves a
   placement at all and the seed exercises nothing. Every placement here is
   on a face or an edge of the solid, and between them they cover each way a
   placement can be written:

     #18  ('...', #15, $,    #17)      omitted axis, a reference AFTER it
     #33  ('...', #30, #31,  $)        the trailing omission
     #43  ('...', #40, $,    *)        `$` and the derived `*` together
     #52  ( ... PLACEMENT(#49) AXIS2_PLACEMENT_3D(#50,$) )   complex instance
     #61  ('...', #58, #+59, #59, #60) only the reference scan can read this

   #18 is the form no reference scan can read: such a scan yields (#15, #17)
   and binds the ref_direction as the AXIS. #43's name carries a comma,
   parentheses, a `#`, a `$` and STEP's `''` escape. #61's `#+59` is not a
   reference — u64's parser would take the `+`, the reference scan does not. */
#1 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#2 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#3 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#4 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#1,'d','c');
#5 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#4)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#1,#2,#3)) REPRESENTATION_CONTEXT('Context3D','3D Context with UNIT and UNCERTAINTY') );
#13 = CARTESIAN_POINT('Vertex.1',(4.,0.,0.));
#14 = VERTEX_POINT('',#13);
#15 = CARTESIAN_POINT('Circle Center',(0.,0.,0.));
#17 = DIRECTION('Circle RefDir',(0.,1.,0.));
#18 = AXIS2_PLACEMENT_3D('Circle Axis2P3D',#15,$,#17);
#19 = CIRCLE('Circle.1',#18,4.);
#20 = EDGE_CURVE('',#14,#14,#19,.T.);
#21 = ORIENTED_EDGE('',*,*,#20,.T.);
#22 = CARTESIAN_POINT('Vertex.2',(4.,0.,1.E1));
#23 = VERTEX_POINT('',#22);
#24 = CARTESIAN_POINT('Line Origin',(4.,0.,0.));
#25 = DIRECTION('Line Dir',(0.,0.,1.));
#26 = VECTOR('Line Vec',#25,1.E1);
#27 = LINE('Line.1',#24,#26);
#28 = EDGE_CURVE('',#14,#23,#27,.T.);
#29 = ORIENTED_EDGE('',*,*,#28,.T.);
#30 = CARTESIAN_POINT('Circle Center',(0.,0.,1.E1));
#31 = DIRECTION('Circle Axis',(0.,0.,1.));
#33 = AXIS2_PLACEMENT_3D('Circle Axis2P3D',#30,#31,$);
#34 = CIRCLE('Circle.2',#33,4.);
#35 = EDGE_CURVE('',#23,#23,#34,.T.);
#36 = ORIENTED_EDGE('',*,*,#35,.F.);
#37 = ORIENTED_EDGE('',*,*,#28,.F.);
#38 = EDGE_LOOP('',(#21,#29,#36,#37));
#39 = FACE_OUTER_BOUND('',#38,.T.);
#40 = CARTESIAN_POINT('Cylinder Center',(0.,0.,0.));
#43 = AXIS2_PLACEMENT_3D('Bore, O''Brien rev.2 (#7) $',#40,$,*);
#44 = CYLINDRICAL_SURFACE('Cylinder.1',#43,4.);
#45 = ADVANCED_FACE('Face.1',(#39),#44,.T.);
#46 = ORIENTED_EDGE('',*,*,#20,.F.);
#47 = EDGE_LOOP('',(#46));
#48 = FACE_OUTER_BOUND('',#47,.T.);
#49 = CARTESIAN_POINT('Plane Origin',(0.,0.,0.));
#50 = DIRECTION('Plane Axis',(0.,0.,-1.));
#52 = ( GEOMETRIC_REPRESENTATION_ITEM() PLACEMENT(#49) REPRESENTATION_ITEM('Plane Axis2P3D') AXIS2_PLACEMENT_3D(#50,$) );
#53 = PLANE('Plane.1',#52);
#54 = ADVANCED_FACE('Face.2',(#48),#53,.T.);
#55 = ORIENTED_EDGE('',*,*,#35,.T.);
#56 = EDGE_LOOP('',(#55));
#57 = FACE_OUTER_BOUND('',#56,.T.);
#58 = CARTESIAN_POINT('Plane Origin',(0.,0.,1.E1));
#59 = DIRECTION('Plane Axis',(0.,0.,1.));
#60 = DIRECTION('Plane RefDir',(1.,0.,0.));
#61 = AXIS2_PLACEMENT_3D('Plane Axis2P3D',#58,#+59,#59,#60);
#62 = PLANE('Plane.2',#61);
#63 = ADVANCED_FACE('Face.3',(#57),#62,.T.);
#64 = CLOSED_SHELL('',(#45,#54,#63));
#65 = MANIFOLD_SOLID_BREP('Pad.1',#64);
#66 = ADVANCED_BREP_SHAPE_REPRESENTATION('Pad.1',(#65),#5);
#70 = AXIS1_PLACEMENT('Rev Axis',#15,$);
ENDSEC;
END-ISO-10303-21;
